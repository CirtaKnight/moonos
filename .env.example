# Sanity (admin panel / CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed for `npm run seed`
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact form (Mail app) via https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, once you verify a domain in Resend:
# CONTACT_FROM_EMAIL="MoonOS <hello@yourdomain.com>"

# Public URL of the site (for social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: raises GitHub API rate limit for the activity feed (no scopes needed)
GITHUB_TOKEN=

# Konshu chatbot fallback (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model override
# GEMINI_MODEL=gemini-2.5-flash
