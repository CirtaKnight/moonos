# Sanity (admin panel / CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed for `npm run seed`
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact form (Mail app) via https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, once you verify a domain in Resend:
# CONTACT_FROM_EMAIL="MoonOS <hello@yourdomain.com>"

# Public URL of the site (for social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: raises GitHub API rate limit for the activity feed (no scopes needed)
GITHUB_TOKEN=

# Konshu chatbot fallback. Groq has a free tier: https://console.groq.com/keys
# (KONSHU_ prefix on purpose: hosts may inject their own GROQ_/GEMINI_ keys for paid gateways.)
KONSHU_GROQ_API_KEY=
# KONSHU_GROQ_MODEL=llama-3.3-70b-versatile
# Alternative (used only when no Groq key is set): https://aistudio.google.com/apikey
# KONSHU_GEMINI_API_KEY=
# KONSHU_GEMINI_MODEL=gemini-2.5-flash
